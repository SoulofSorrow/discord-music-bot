{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npx eslint:*)",
      "Bash(node --experimental-sqlite --test:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose pull:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)"
    ]
  }
}
