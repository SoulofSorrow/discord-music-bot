# --- Required ---------------------------------------------------------------
# Discord bot token and application (client) ID from
# https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# Optional: register slash commands instantly for a single server (guild).
# Omit for global commands (can take up to an hour to propagate).
GUILD_ID=

# --- YouTube ----------------------------------------------------------------
# YouTube Data API v3 key (Google Cloud console → enable "YouTube Data API v3").
# Used for search, video/playlist resolution. Without it, the bot falls back to
# yt-dlp scraping for search (single videos only; playlist links need the key).
YOUTUBE_API_KEY=

# --- Spotify (optional) -----------------------------------------------------
# Client Credentials app from https://developer.spotify.com/dashboard.
# Required for album/playlist links and reliable track metadata. Without them,
# only single track/episode links work (via Spotify's public oEmbed endpoint).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Behaviour --------------------------------------------------------------
# When no channel is bound and no user is followed, allow /play to join the
# caller's current voice channel. Set to "false" to require /bind or /follow.
ALLOW_CALLER_FALLBACK=true

# Leave the voice channel after this many milliseconds with an empty queue, or
# when left alone with no human listeners. Set to 0 to disable auto-leave.
IDLE_TIMEOUT_MS=300000

# Optional yt-dlp cookies for age-restricted videos / bot-detection challenges.
# Provide EITHER a Netscape cookies file path, OR a browser name to read from.
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=

# Set to "true" for verbose @discordjs/voice connection logging.
VOICE_DEBUG=false

# --- Web dashboard (optional) -------------------------------------------------
# Website with "Login with Discord" SSO for controlling the bot. Only visible to
# users who are admin (Manage Server permission or an admin role) on a server
# both they and the bot are in. Disabled by default.
WEB_ENABLED=false
WEB_PORT=3000

# Public https URL the dashboard is reached at (behind your reverse proxy) —
# used to build the OAuth redirect URI: <WEB_BASE_URL>/auth/discord/callback.
# Add that exact URL under your Discord application → OAuth2 → Redirects.
WEB_BASE_URL=https://music.example.com

# Client secret for the SAME Discord application as CLIENT_ID above
# (Discord Developer Portal → OAuth2 → Client Secret).
DISCORD_CLIENT_SECRET=

# Random string used to sign session cookies, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
